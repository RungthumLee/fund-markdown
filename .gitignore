# secrets — NEVER commit
.env
.env.local
.env.*.local

# all generated data — regenerate with: python run_all.py
# nothing here is authored by hand, and some files exceed GitHub's 100MB
# per-file limit (data/processed/funds.json is ~156MB, data/raw is ~1GB).
# The published product is the markdown in vault/, not the JSON it is built from.
# Everything derived lives under data/ and is rebuilt from the API - except the
# factsheet PDFs, which are the primary documents the notes quote from and are
# not always still downloadable from the AMC once a newer edition replaces them.
# data/* rather than data/, because git will not look inside an excluded
# directory and the negation below would never be reached.
data/*
!data/factsheets/

# scratch
_tmp/

# logs
logs/
*.log

# python
__pycache__/
*.py[cod]
.venv/
venv/

# obsidian per-user UI state (leading **/ so it matches vault/.obsidian too;
# a mid-pattern slash without it anchors to the repo root and misses subdirs)
**/.obsidian/workspace*
**/.obsidian/cache

# os
Thumbs.db
.DS_Store
